@model Pri.Ee.Client.Models.Loans.LoanViewModel

<h2 class="page-title mb-4">Loan Details</h2>

<div class="details-card">

    <div class="details-row">
        <span class="label">Id</span>
        <span class="value">@Model.Id</span>
    </div>

    <div class="details-row">
        <span class="label">Book</span>
        <span class="value">@(Model.BookTitle ?? "Unknown book")</span>
    </div>

    <div class="details-row">
        <span class="label">User</span>
        <span class="value">@(Model.UserName ?? Model.UserId)</span>
    </div>

    <div class="details-row">
        <span class="label">Loan Date</span>
        <span class="value">@Model.LoanDate.ToShortDateString()</span>
    </div>

    <div class="details-row">
        <span class="label">Return Date</span>
        <span class="value">
            @(Model.ReturnDate.HasValue
                ? Model.ReturnDate.Value.ToShortDateString()
                : "Not returned")
        </span>
    </div>

</div>

<a asp-controller="Loans" asp-action="Index" class="btn btn-back mt-4">
    ← Back to Loans
</a>
