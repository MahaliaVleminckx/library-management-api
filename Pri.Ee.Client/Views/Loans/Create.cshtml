@model Pri.Ee.Client.Models.Loans.CreateLoanViewModel

<h2 class="page-title mb-4">Create Loan</h2>

<div class="form-card">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Book Id</label>
            <input asp-for="BookId" class="form-control" />
            <span asp-validation-for="BookId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">User Id</label>
            <input asp-for="UserId" class="form-control" />
            <span asp-validation-for="UserId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-create-custom w-100">
            Create Loan
        </button>

    </form>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">
            @ViewBag.Error
        </div>
    }

</div>

<a asp-controller="Loans" asp-action="Index" class="btn btn-back mt-4">
    ← Back to Loans
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
