@model Pri.Ee.Client.Models.Categories.CategoryViewModel

<h2 class="page-title mb-4">Category Details</h2>

<div class="details-card">

    <div class="details-row">
        <span class="label">Id</span>
        <span class="value">@Model.Id</span>
    </div>

    <div class="details-row">
        <span class="label">Name</span>
        <span class="value book-title">@Model.Name</span>
    </div>

</div>

<a href="/Categories" class="btn btn-back mt-4">
    ← Back to Categories
</a>