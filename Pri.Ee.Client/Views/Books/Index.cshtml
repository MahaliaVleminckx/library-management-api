@model List<Pri.Ee.Client.Models.Books.BookViewModel>
@using System.Security.Claims

<h2 class="page-title mb-4">Books</h2>

@{
    var isAdmin = User.IsInRole("Admin");
 }


<div class="table-container">

    <table class="table table-custom">

        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Description</th>
                <th>Author</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>

                    <td class="book-title">@book.Title</td>

                    <td>@book.Description</td>
                    <td>@book.AuthorName</td>

                    <td class="actions-cell">
                        <a class="btn btn-sm btn-action btn-info-custom"
                           href="/Books/Details/@book.Id">Details</a>

                        @if (isAdmin)
                        {
                        <a class="btn btn-sm btn-action btn-edit-custom"
                           href="/Books/Edit/@book.Id">Edit</a>


                        <a class="btn btn-sm btn-action btn-delete-custom"
                           href="/Books/Delete/@book.Id"
                           onclick="return confirm('Are you sure?')">
                            Delete
                        </a>
                        }
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>
@if (isAdmin)
{
<p>
    <a class="btn btn-create-custom mt-3" href="/Books/Create">
        + Create New Book
    </a>
</p>
}

