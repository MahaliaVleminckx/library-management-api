@model Pri.Ee.Client.Models.Authors.AuthorViewModel

<h2 class="page-title mb-4">Author Details</h2>

<div class="details-card">

    <div class="details-row">
        <span class="label">Id</span>
        <span class="value">@Model.Id</span>
    </div>

    <div class="details-row">
        <span class="label">Name</span>
        <span class="value book-title">@Model.Name</span>
    </div>

</div>

<a href="/Authors" class="btn btn-back mt-4">
    ← Back to Authors
</a>