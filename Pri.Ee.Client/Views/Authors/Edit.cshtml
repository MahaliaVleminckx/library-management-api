@model Pri.Ee.Client.Models.Authors.CreateAuthorViewModel

<h2 class="page-title mb-4">Edit Author</h2>

<div class="form-card">

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" />
        </div>

        <button type="submit" class="btn btn-edit-custom w-100">
            Save Changes
        </button>

    </form>

</div>

<a href="/Authors" class="btn btn-back mt-4">
    ← Back to Authors
</a>

